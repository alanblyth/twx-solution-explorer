{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "npm", "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "explorer": {
      "projectType": "application",
      "root": "apps/explorer",
      "sourceRoot": "apps/explorer/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/explorer/src/main.ts",
            "tsConfig": "apps/explorer/tsconfig.app.json",
            "polyfills": [],
            "outputHashing": "none",
            "outputPath": { "base": "dist/explorer", "browser": "" },
            "index": false,
            "styles": []
          },
          "configurations": {
            "production": { "optimization": true, "extractLicenses": true, "budgets": [{ "type": "initial", "maximumWarning": "600kB", "maximumError": "1MB" }] },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
